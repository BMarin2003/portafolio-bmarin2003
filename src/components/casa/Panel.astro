---
import { Image } from 'astro:assets';
import { bands, rol } from '../../data/site';
import { contenido, t, type Lang } from '../../i18n';
import type { Credit } from '../../data/site';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const x = t[lang].casa;
const { games, screens } = contenido(lang);
const lista: { id: 'pc' | 'tv'; kicker: string; titulo: string; items: Credit[] }[] = [
  { id: 'pc', kicker: x.pc[0], titulo: x.pc[1], items: games },
  { id: 'tv', kicker: x.tv[0], titulo: x.tv[1], items: screens },
];
---
<aside class="casa-panel" aria-live="polite">
  {lista.map((l) => (
    <section class="casa-seccion" data-panel={l.id}>
      <p class="mono kind accent-k">{l.kicker}</p>
      <h2 tabindex="-1">{l.titulo}</h2>
      <ul class="casa-lista">
        {l.items.map((it) => (
          <li>
            <span class="casa-item">{it.cover ? <Image src={it.cover} alt={it.title} width={160} /> : it.title}</span>
            <a class="credit mono" href={it.sourceUrl} aria-label={`${it.title} ${x.via} ${it.source}`}>{x.via} {it.source}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <section class="casa-seccion" data-panel="parlante">
    <p class="mono kind accent-k">{x.parlante[0]}</p>
    <h2 tabindex="-1">{x.parlante[1]}</h2>
    <p class="casa-nota">{x.parlanteNota}</p>
    <ul class="casa-lista">
      {bands.map((b) => <li><span class="casa-item">{b.title}</span></li>)}
    </ul>
  </section>
  <section class="casa-seccion" data-panel="mesa">
    <p class="mono kind accent-k">{x.mesa[0]}</p>
    <h2 tabindex="-1">{rol[0]}, {x.mesa[1]} {rol[1]}</h2>
  </section>
  <section class="casa-seccion" data-panel="estante">
    <p class="mono kind accent-k">{x.estante[0]}</p>
    <h2 tabindex="-1">{x.estante[1]}</h2>
  </section>
</aside>
