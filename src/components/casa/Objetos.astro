---
import { objetos } from '../../lib/casa/scene';
import { textosCasa } from '../../lib/casa/textos';
import { t, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const x = t[lang].casa;
---
<nav class="casa-objetos" aria-label={x.objetosAria}>
  <p class="mono kind">{x.objetosKicker}</p>
  <div class="casa-objetos-lista">
    {objetos.map((o) => (
      <button type="button" class="mono casa-objeto" data-objeto={o.id} aria-pressed={o.id === 'parlante' ? 'true' : 'false'}>{textosCasa[lang].objetos[o.id]}</button>
    ))}
  </div>
</nav>
