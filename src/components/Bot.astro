---
interface Props {
  color: string;
  variant?: 'sleepy' | 'helmet';
  motion?: 'breathe' | 'type';
  delay?: 0 | 1 | 2;
  size?: 'sm' | 'md';
}
const { color, variant, motion = 'breathe', delay = 0, size = 'md' } = Astro.props;
---
<span class={`bot-move ${motion} d${delay}`} aria-hidden="true" data-bot>
  <span class={`bot ${size} ${variant ?? ''}`} style={`background:${color}`}>
    <span class="eyes"><span class="eye"></span><span class="eye"></span></span>
  </span>
</span>
