---
import Bot from './Bot.astro';
import { bands, crew, games, screens } from '../data/site';

const motions = ['breathe', 'breathe', 'type', 'breathe', 'breathe'] as const;
const delays = [0, 1, 0, 2, 0] as const;
---
<section class="house wrap" aria-label="La casa en corte">
  <div class="house-row">
    <div class="house-body">
      <div class="roof"><div class="roof-in"></div></div>
      <div class="floors">
        <a href="#taller" class="floor taller" data-floor="taller">
          <span class="mono tag">N+2 · TALLER · 09–18 H</span>
          <span class="window" aria-hidden="true"></span>
          <span class="sun glow" aria-hidden="true"></span>
          <div class="crew-row">
            {crew.map((c, i) => (
              <div class="crew-slot">
                <Bot color={c.color} variant={c.variant} motion={motions[i % 5]} delay={delays[i % 5]} />
                <div class="desk"></div>
              </div>
            ))}
          </div>
        </a>

        <div class="slab" aria-hidden="true"></div>

        <a href="#cuarto" class="floor cuarto" data-floor="cuarto">
          <span class="mono tag">N+1 · CUARTO · 18 H →</span>
          <span class="window night" aria-hidden="true"></span>
          <span class="moon" aria-hidden="true"></span>
          <div class="room-row">
            <div class="screen-wrap">
              <div class="screen pc" data-screen="pc">
                <span class="mono kind">PC</span>
                <span class="lead accent" data-rotate>
                  {games.map((g, i) => <span hidden={i > 0}>{g.title}</span>)}
                </span>
              </div>
              <div class="stand pc-stand"></div>
            </div>
            <Bot color="#D9A55B" delay={1} />
            <div class="table" aria-hidden="true">
              <div class="dice">
                <span class="d6"></span>
                <span class="d4"></span>
              </div>
              <div class="top"></div>
              <div class="legs"></div>
            </div>
            <div class="screen-wrap tv-wrap">
              <div class="screen tv" data-screen="tv">
                <span class="mono kind">TV</span>
                <span class="lead" data-rotate>
                  {screens.map((s, i) => <span hidden={i > 0}>{s.title}</span>)}
                </span>
              </div>
              <div class="stand tv-stand"></div>
            </div>
            <div class="speaker-box" aria-hidden="true">
              <span class="woofer"></span>
              <span class="tweeter"></span>
            </div>
          </div>
        </a>
      </div>
      <div class="ground-line" aria-hidden="true"></div>
      <div class="ground-hatch" aria-hidden="true"></div>
    </div>
    <div class="mono plan-notes" aria-hidden="true">
      <div class="roof-gap"></div>
      <div class="note">
        <span class="elev">+6.00</span><span>Taller</span><span>CorAll, la cuadrilla</span>
      </div>
      <div class="slab-gap"></div>
      <div class="note">
        <span class="elev">+3.00</span><span>Cuarto</span><span>rol, juegos, pantalla, música</span>
      </div>
    </div>
  </div>
  <p class="mono caption" data-speaker>
    EN EL PARLANTE · <span class="band" data-rotate>{bands.map((b, i) => <span hidden={i > 0}>{b}</span>)}</span><span class="band" data-live hidden></span> · lo que suena ahora, o rotando si no hay nada
  </p>
</section>
