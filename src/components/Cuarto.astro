---
import { Image } from 'astro:assets';
import { bands, games, rol, screens } from '../data/site';
import type { Credit } from '../data/site';

const lists: { id: 'pc' | 'tv'; label: string; items: Credit[]; accent?: boolean }[] = [
  { id: 'pc', label: 'LA PC', items: games, accent: true },
  { id: 'tv', label: 'LA TELE', items: screens },
];
---
<section id="cuarto" class="cuarto-section" aria-labelledby="cuarto-h">
  <div class="cuarto-inner">
    <div class="section-head">
      <span class="mono level">N+1</span>
      <h2 id="cuarto-h">El cuarto</h2>
      <span class="muted">Después de las 6.</span>
    </div>
    <div class="cards">
      <div class="card" data-card="mesa">
        <span class="mono kind">LA MESA</span>
        <span class="big">{rol[0]}, luego {rol[1]}</span>
      </div>
      {lists.map((l) => (
        <div class="card" data-card={l.id}>
          <span class="mono kind">{l.label}</span>
          <div data-rotate>
            {l.items.map((it, i) => (
              <div hidden={i > 0}>
                <span class:list={['big', { accent: l.accent }]}>{it.cover ? <Image src={it.cover} alt={it.title} width={160} /> : it.title}</span>
                <a class="credit mono" href={it.sourceUrl} aria-label={`${it.title} vía ${it.source}`}>vía {it.source}</a>
              </div>
            ))}
          </div>
        </div>
      ))}
      <div class="card" data-card="speaker" data-speaker>
        <span class="mono kind">EL PARLANTE</span>
        <div data-rotate>
          {bands.map((b, i) => <span class="big" hidden={i > 0}>{b}</span>)}
        </div>
        <span class="big" data-live hidden></span>
      </div>
    </div>
  </div>
</section>
