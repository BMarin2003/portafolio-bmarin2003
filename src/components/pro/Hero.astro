---
import Obra from './Obra.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const x = t[lang].pro;
---
<section id="top" class="hero">
  <div class="hero-in">
    <div class="hero-text">
      <span class="mono hero-tag"><span class="hero-dot" aria-hidden="true"></span>{x.heroTag}</span>
      <h1>{x.h1}</h1>
      <p class="hero-lede">{x.lede}</p>
      <div class="hero-ctas">
        <a href="#proyectos" class="btn btn-main">{x.verObra}</a>
        <a href="#oficios" class="btn btn-line mono">{x.conocer}</a>
      </div>
    </div>
  </div>
  <Obra lang={lang} />
</section>
