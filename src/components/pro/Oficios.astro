---
import Sprite from '../Sprite.astro';
import { contenido, t, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const x = t[lang].pro;
const { oficios } = contenido(lang);
---
<section id="oficios" class="seccion" aria-labelledby="oficios-h">
  <p class="mono kicker">{x.oficiosKicker}</p>
  <h2 id="oficios-h" class="tight">{x.oficiosH2}</h2>
  <p class="seccion-lede">{x.oficiosLede}</p>
  <div class="grid">
    {oficios.map((o) => (
      <article class="panel oficio">
        <Sprite name={o.sprite} anim="action" scale={4} class="act" />
        <div class="oficio-body">
          <h3>{o.oficio}</h3>
          <span class="mono area">{o.area}</span>
          <ul class="tags">
            {o.tags.map((t) => <li class="mono">{t}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
