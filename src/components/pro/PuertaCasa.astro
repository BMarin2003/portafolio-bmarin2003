---
import Sprite from '../Sprite.astro';
import { href, t, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const x = t[lang].pro;
---
<section class="puerta-band" aria-labelledby="casa-h">
  <a href={href(lang, '/casa')} class="wrap puerta">
    <div class="puerta-text">
      <p class="mono puerta-kicker">{x.puertaKicker}</p>
      <h2 id="casa-h">{x.puertaH2}</h2>
      <p>{x.puertaP}</p>
    </div>
    <div class="puerta-escena">
      <span class="paseo" aria-hidden="true"><Sprite name="bryan" anim="walk" scale={4} /></span>
      <span class="puerta-door" aria-hidden="true"><span class="puerta-pomo"></span></span>
      <span class="mono puerta-cta">{x.puertaCta}</span>
    </div>
  </a>
</section>
