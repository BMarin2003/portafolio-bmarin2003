---
import Sprite from '../Sprite.astro';
import { comoTrabajo } from '../../data/site';
---
<section id="ia" class="seccion ia" aria-labelledby="ia-h">
  <div class="ia-text">
    <p class="mono kicker">03 · CÓMO TRABAJO</p>
    <h2 id="ia-h">Con IA, sin dejar de aprender</h2>
    <p class="seccion-lede">{comoTrabajo}</p>
  </div>
  <div class="ia-sprites">
    <Sprite name="doble" anim="action" scale={5} class="act slow" />
    <Sprite name="bryan" anim="roll" scale={5} class="roll" />
  </div>
</section>
