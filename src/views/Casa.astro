---
import Base from '../layouts/Base.astro';
import Pie from '../components/Pie.astro';
import Reloj from '../components/casa/Reloj.astro';
import Cuarto from '../components/casa/Cuarto.astro';
import Sala from '../components/casa/Sala.astro';
import MesaRol from '../components/casa/MesaRol.astro';
import { href, otraRuta, t, type Lang } from '../i18n';
import '../styles/casa.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const x = t[lang].casa;
const otra = otraRuta(Astro.url.pathname);
---
<Base title={x.title} description={x.description} lang={lang} ogImage="/og-casa.png" ogImageAlt={x.ogAlt}>
  <div class="page casa-page" data-casa>
    <header class="wrap site-header">
      <nav class="mono" aria-label={t[lang].pro.navAria}>
        <a href={href(lang, '/')}>{x.volver}</a>
        <a href={otra.path} hreflang={otra.lang} lang={otra.lang}>{t[lang].otroIdioma}</a>
      </nav>
      <Reloj />
    </header>

    <main class="wrap casa-main">
      <h1>{x.h1}</h1>
      <p class="casa-sub">{x.sub}</p>

      <Cuarto lang={lang} />
      <Sala lang={lang} />
      <MesaRol lang={lang} />

      <p class="casa-creditos">{x.creditos}</p>
    </main>

    <Pie lang={lang} />
  </div>
</Base>

<script>
  import { startRotation } from '../scripts/rotate';
  import { startNowPlaying } from '../scripts/now-playing';
  import { initReloj } from '../scripts/casa/reloj';

  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  startRotation(document, { intervalMs: 3200, reducedMotion: reducido });
  startNowPlaying([...document.querySelectorAll<HTMLElement>('[data-speaker]')]);
  const reloj = document.querySelector<HTMLElement>('[data-reloj]');
  if (reloj) initReloj(reloj, { reducido });
</script>
