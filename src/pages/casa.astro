---
import Base from '../layouts/Base.astro';
import Pie from '../components/Pie.astro';
import Reloj from '../components/casa/Reloj.astro';
import Objetos from '../components/casa/Objetos.astro';
import Panel from '../components/casa/Panel.astro';
import { bands } from '../data/site';
---
<Base
  title="La casa de Bryan"
  description="La casa de Bryan después de las 6: rol, juegos, series y lo que suena ahora en Spotify."
>
  <div class="page casa-page" data-casa>
    <header class="wrap site-header">
      <a href="/" class="mono">← volver a la obra</a>
      <Reloj />
    </header>

    <main class="wrap casa-main">
      <h1 data-titulo>La casa, después de las 6</h1>
      <p class="casa-sub" data-subtitulo>Bryan en la PC; la cuadrilla llegó para la partida de rol.</p>

      <div class="casa-escena" data-scene aria-hidden="true">
        <img src="/casa-estatica.png" alt="" width="1100" height="640" />
      </div>

      <p class="mono casa-parlante" data-speaker>
        <span aria-hidden="true">♪ </span>
        <span data-rotate>
          {bands.map((b, i) => <span hidden={i > 0}>{b}</span>)}
        </span>
        <span data-live hidden></span>
      </p>

      <div class="casa-bajo">
        <Objetos />
        <Panel />
      </div>
    </main>

    <Pie />
  </div>
</Base>

<script>
  import { startRotation } from '../scripts/rotate';
  import { startNowPlaying } from '../scripts/now-playing';
  import { initCasaUI } from '../scripts/casa/ui';
  import { bootCasa } from '../scripts/casa/boot';

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  startRotation(document, { intervalMs: 3200, reducedMotion });
  startNowPlaying([...document.querySelectorAll<HTMLElement>('[data-speaker]')]);
  const root = document.querySelector<HTMLElement>('[data-casa]')!;
  const ui = initCasaUI(root);
  void bootCasa(root, { reducedMotion, ui, loadScene: () => import('../scripts/casa/scene') });
</script>
